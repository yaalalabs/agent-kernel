# Agent Kernel + Dagaya Example Environment File
# DO NOT ADD REAL SECRETS TO THIS FILE!
# Copy this to `.env` and fill in your actual values.

# ---------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------

# Primary LLM provider for fast, cost-effective inference (Llama/Qwen models)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Secondary LLM provider for robust multi-lingual fallback and complex routing
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# ---------------------------------------------------------
# WhatsApp Webhook Integration (Optional for CLI Demo)
# ---------------------------------------------------------

# The permanent access token generated from your Meta Developer Console
WHATSAPP_ACCESS_TOKEN="EAA_your_meta_access_token_here"

# The specific Phone Number ID provided by Meta
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# A secure string you define to verify the webhook connection with Meta
WHATSAPP_VERIFY_TOKEN="dagaya_secure_webhook_token_2026"
