# Copy to .env and fill in. .env is gitignored; never commit real tokens or keys.
#   cp .env.example .env

# OpenAI API key, read from os.environ by the OpenAI Agents SDK.
OPENAI_API_KEY=sk-...

# WhatsApp Cloud API credentials, read by Agent Kernel as config.whatsapp.*
# A random string you invent; must match the verify token in the Meta developer portal.
AK_WHATSAPP__VERIFY_TOKEN=
# Permanent access token from WhatsApp > Getting Started.
AK_WHATSAPP__ACCESS_TOKEN=
# Test or business phone number ID from WhatsApp > Getting Started.
AK_WHATSAPP__PHONE_NUMBER_ID=
# Required by server.py: authenticates sender identities via HMAC-SHA256 webhook signatures.
AK_WHATSAPP__APP_SECRET=

# Optional path to the operator-managed registry; defaults beside phm_registry.py.
MATHRU_PHM_REGISTRY=./phm_registry.yaml

# Agent model override only. Guardrail wrapper models and JSON check models are separate.
# See README "Model and rate limits" for all settings.
MATHRU_MODEL=gpt-5.4-mini
