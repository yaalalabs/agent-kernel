# Copy to .env. Never commit credentials or uploaded documents.
SCOPEWISE_PRODUCTION=false
SCOPEWISE_PUBLIC_URL=http://127.0.0.1:8080
SCOPEWISE_INVITATION=scopewise-local
SCOPEWISE_MODEL=llama3.1:latest
SCOPEWISE_MODEL_URL=http://127.0.0.1:11434/v1
SCOPEWISE_EMBED_MODEL=nomic-embed-text:latest
SCOPEWISE_SEMANTIC_INDEX=true
# SCOPEWISE_DATA=/absolute/private/data/path

# Optional Telegram. Both are required to enable the webhook.
AK_TELEGRAM__BOT_TOKEN=
AK_TELEGRAM__WEBHOOK_SECRET=
# Used only by compose TLS profile. Set to a domain pointing at the server.
SCOPEWISE_DOMAIN=
